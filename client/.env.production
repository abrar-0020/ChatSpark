# Production Environment Variables for GitHub Pages

# For now, point to your local backend
# You'll need to run the backend locally or deploy it separately
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# If you deploy backend to Render/Railway later, update these:
# VITE_API_URL=https://your-backend-url.com/api
# VITE_SOCKET_URL=https://your-backend-url.com
